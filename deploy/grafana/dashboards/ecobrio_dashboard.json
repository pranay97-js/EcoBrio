{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Core System Performance & PRD Targets",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1000 },
              { "color": "green", "value": 3000 }
            ]
          },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Peak Request Rate (PRD Target: ≥ 3,000 RPS)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(ecobrio_requests_total[10s]))",
          "legendFormat": "RPS",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.025 },
              { "color": "red", "value": 0.040 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Reservation p99 Latency (PRD Target: < 40ms)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(ecobrio_request_duration_seconds_bucket{route=~\"/api/v1/bookings.*\"}[1m])) by (le))",
          "legendFormat": "p99",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.010 },
              { "color": "red", "value": 0.015 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "WebSocket Fan-Out Latency (PRD Target: < 15ms)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ecobrio_websocket_broadcast_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Broadcast",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "WAL Corruptions (PRD Target: 0% Loss)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(ecobrio_wal_corruption_total) or vector(0)",
          "legendFormat": "Corruptions",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Booking Engine Concurrency & Contention",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "Booking Request Rate by Outcome (201 Created vs 409 Conflict)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(ecobrio_requests_total{route=~\"/api/v1/bookings.*\"}[10s])) by (status)",
          "legendFormat": "Status {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "Booking Contention Conflicts & Compensations",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(ecobrio_booking_conflicts_total[10s])) by (reason)",
          "legendFormat": "Conflict: {{reason}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(ecobrio_booking_compensation_total[10s])) by (outcome)",
          "legendFormat": "Compensated: {{outcome}}",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Write-Ahead Log (WAL) Durability & Telemetry Ingestion",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 7,
      "title": "WAL Records Appended vs Durable (fsynced)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(ecobrio_wal_records_appended_total[10s])",
          "legendFormat": "Appended/s",
          "refId": "A"
        },
        {
          "expr": "rate(ecobrio_wal_records_durable_total[10s])",
          "legendFormat": "Fsynced Durable/s",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 8,
      "title": "WAL Crash Recovery Workload (Replayed Records)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(ecobrio_wal_records_replayed_total) by (outcome)",
          "legendFormat": "Replayed: {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "WebSocket Real-Time Distribution & Queue Backlog",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 9,
      "title": "Active WebSocket Connections",
      "type": "timeseries",
      "targets": [
        {
          "expr": "ecobrio_websocket_connections",
          "legendFormat": "Connected Clients",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 10,
      "title": "Transactional Outbox & Queue Lag",
      "type": "timeseries",
      "targets": [
        {
          "expr": "ecobrio_outbox_oldest_pending_seconds",
          "legendFormat": "Oldest Outbox Event Age (s)",
          "refId": "A"
        },
        {
          "expr": "sum(ecobrio_queue_messages_pending) by (queue_name)",
          "legendFormat": "Queue Backlog: {{queue_name}}",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["ecobrio", "reverse-logistics", "observability"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["1s", "5s", "10s", "30s", "1m"]
  },
  "timezone": "browser",
  "title": "ECOBrio Distributed Reverse-Logistics Platform",
  "uid": "ecobrio-main-v1",
  "version": 1
}
