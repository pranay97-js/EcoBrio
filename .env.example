# ECOBrio Environment Configuration

# Server
PORT=8080
ENV=development
LOG_LEVEL=debug

# Relational Database (PostgreSQL 16)
DATABASE_URL=postgres://ecobrio:ecobriosecret@localhost:5432/ecobrio_db?sslmode=disable
POSTGRES_USER=ecobrio
POSTGRES_PASSWORD=ecobriosecret
POSTGRES_DB=ecobrio_db
POSTGRES_PORT=5432

# In-Memory & Cache (Redis 7)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=ecobrioredis
REDIS_DB=0

# LocalStack AWS Emulation
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_INCIDENTS_QUEUE_URL=http://localhost:4566/000000000000/ecobrio-incidents
SQS_CREDITS_QUEUE_URL=http://localhost:4566/000000000000/ecobrio-credits
S3_RECEIPTS_BUCKET=ecobrio-receipts

# Custom Segmented WAL Configuration
WAL_DIR=./data/wal
WAL_SEGMENT_MAX_BYTES=10485760
WAL_BATCH_DELAY_MS=10
WAL_BATCH_MAX_SIZE=50

# AI Provider Configuration (mock, gemini, groq)
AI_PROVIDER=mock
GEMINI_API_KEY=
GROQ_API_KEY=
